{
  "manifest_version": 3,
  "name": "Carpetas YouTube — Organizador de Suscripciones",
  "version": "1.1.0",
  "description": "Crea carpetas en el sidebar de YouTube para organizar tus canales/suscripciones. Todo se guarda localmente en tu navegador.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": "icons/icon48.png",
    "default_title": "Carpetas YouTube — gestiona tus carpetas desde el sidebar de YouTube"
  },
  "permissions": ["storage"],
  "background": {
    "service_worker": "background.js"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": [
        "content/core/utils.js",
        "content/core/store.js",
        "content/core/channel.js",
        "content/wall/videos.js",
        "content/wall/wall.js",
        "content/subs/subs.js",
        "content/subs/feed-cache.js",
        "content/subs/popup.js",
        "content/sidebar/forms.js",
        "content/sidebar/sidebar.js",
        "content/watch/watch-button.js",
        "content/samemenu/samemenu.js"
      ],
      "css": [
        "content/core/shared.css",
        "content/sidebar/sidebar.css",
        "content/wall/folderView.css",
        "content/subs/subs.css",
        "content/watch/watch.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
